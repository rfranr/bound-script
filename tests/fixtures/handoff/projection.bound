system Projection {
    type Empty {}
    type Input {
        z: string
        a: number
        enabled: boolean
    }
    type Record_Input { value: string }
    box EmptyBox { operation make(input: Empty): Empty }
    box Shared { operation echo(input: Input): Input }
    box Collision { operation convert(input: Input): Record_Input }
    box Text { operation echo(input: string): string }
    box Numeric { operation echo(input: number): number }
    box Flag { operation echo(input: boolean): boolean }
    box VoidBox { operation show(input: string): void }
    director Main {
        on start { print("Trusted projection fixtures") }
    }
}
