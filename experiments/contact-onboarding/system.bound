system ContactOnboarding {
    type ContactSubmission {
        requestId: string
        name: string
        email: string
        locale: string
        consent: boolean
        trialDays: number
    }
    type NormalizedContact {
        requestId: string
        displayName: string
        email: string
        locale: string
        consent: boolean
        trialDays: number
        valid: boolean
        reason: string
    }
    type WelcomeMessage {
        requestId: string
        send: boolean
        recipient: string
        subject: string
        html: string
        reason: string
    }
    box NormalizeContact {
        operation normalize(submission: ContactSubmission): NormalizedContact
        ensure result.reason != ""
    }
    box RenderWelcome {
        operation render(contact: NormalizedContact): WelcomeMessage
        ensure result.subject != ""
    }
    director Main {
        on start {
            print("Pilot uses external fixed-input wiring")
        }
    }
}
