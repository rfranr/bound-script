system HelloWorld {
    box Greeter {
        greet(name: String) -> String
        ensure result == "Hello, " + name + "!"
    }

    box Display {
        show(message: String)
        allow screen.write
    }

    director Main {
        use Greeter
        use Display

        on start {
            message = Greeter.greet("World")
            Display.show(message)
        }
    }

}
